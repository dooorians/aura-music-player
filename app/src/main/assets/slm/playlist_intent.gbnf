# What the playlist assistant's model may write, and nothing else: one JSON object, compact (no whitespace, no prose,
# no markdown fence), with exactly these seven keys in this order. Every value is null or inside its range; a string is
# lower case, 1 to 24 characters, and cannot hold a quote, a brace or a backslash. Lists hold at most six genres.
# Read by the sampler token by token (llama.cpp grammar-based sampling): a token that would leave this language is
# never chosen. Also read by PlaylistIntentGrammarTest, which checks the examples of the prompt against it.
root        ::= "{" bpm-kv "," tol-kv "," energy-kv "," include-kv "," exclude-kv "," minutes-kv "," mood-kv "}"
bpm-kv      ::= "\"target_bpm\":" ( bpm | "null" )
tol-kv      ::= "\"bpm_tolerance\":" ( tolerance | "null" )
energy-kv   ::= "\"energy_level\":" ( "\"low\"" | "\"medium\"" | "\"high\"" | "null" )
include-kv  ::= "\"genres_included\":" genres
exclude-kv  ::= "\"genres_excluded\":" genres
minutes-kv  ::= "\"target_duration_minutes\":" ( minutes | "null" )
mood-kv     ::= "\"mood\":" ( word | "null" )
bpm         ::= [4-9] [0-9] | "1" [0-9] [0-9] | "2" [0-4] [0-9]
tolerance   ::= [1-9] | [1-3] [0-9]
minutes     ::= [1-9] | [1-9] [0-9] | [1-4] [0-9] [0-9]
genres      ::= "[" ( word ( "," word ){0,5} )? "]"
word        ::= "\"" [a-z0-9àâçéèêëîïôùûü] [a-z0-9àâçéèêëîïôùûü &'-]{0,23} "\""
